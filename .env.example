# Copy to .env for local development.
DATABASE_PATH=data/linksink.db
ORIGIN=http://localhost:5173
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Mail: under `npm run dev` it is printed to the console. A built server needs RESEND_API_KEY and MAIL_FROM,
# or MAIL_TRANSPORT=console (tests only: it prints live sign-in links to the log).
RESEND_API_KEY=
MAIL_FROM=
MAIL_TRANSPORT=
MAIL_OUTBOX=
