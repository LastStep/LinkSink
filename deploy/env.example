# LinkSink's settings for Docker Compose. They go in the .env beside compose.yaml:
#   cp deploy/env.example .env
# or, when a .env for `npm run dev` is already there, add them to it:
#   cat deploy/env.example >> .env
# Every name starts with LINKSINK_, so they never mix with the dev settings in the same file.

# The host name LinkSink is served at: no https://, no port, no path. The app's origin is https:// and this name.
# localhost: this machine only, with a certificate from Caddy's own local authority (the browser warns until you
# trust it). On a server: the domain or subdomain pointing at it, e.g. links.example.com, and Caddy fetches a public
# certificate from Let's Encrypt.
LINKSINK_HOST=localhost

# The address ports 80 and 443 listen on. 127.0.0.1: reachable from this machine only. Empty: every address (a server).
LINKSINK_LISTEN=127.0.0.1

# The secret sessions are signed with: at least 32 random characters. Make one with: openssl rand -base64 32
# Changing it later signs every device out.
LINKSINK_AUTH_SECRET=

# How mail is sent (the link that confirms the email address, a password reset): resend, or console.
# console prints each mail to `docker compose logs app`. For trying it on this machine only: the log then holds live
# sign-in links. Empty means resend.
LINKSINK_MAIL_TRANSPORT=console

# With resend: the Resend API key, and the From address, e.g. LinkSink <mail@links.example.com>.
LINKSINK_RESEND_API_KEY=
LINKSINK_MAIL_FROM=
