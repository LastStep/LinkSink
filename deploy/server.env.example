# LinkSink's settings for a server, or any machine that runs the published image (deploy/SERVER.md). They go in the
# .env beside compose.yaml on that machine:
#   cp deploy/server.env.example .env
# deploy/env.example is for trying LinkSink on this development machine; never copy it to a server as it is.

# The host name LinkSink is served at: no https://, no port, no path. The app's origin is https:// and this name.
# A server with a domain: the domain or subdomain pointing at it, and Caddy fetches a public certificate from Let's
# Encrypt (ports 80 and 443 open to the internet). A machine on the home network with no domain: its address
# (192.168.1.20) or a local name (linksink.home.arpa, nas.local), and Caddy makes its own certificate, which browsers
# warn about until it is trusted.
LINKSINK_HOST=links.example.com

# The address ports 80 and 443 listen on. Empty: every address, as a server needs.
LINKSINK_LISTEN=

# The port plain http is published on; it only redirects to https. 80, which Let's Encrypt also needs.
LINKSINK_HTTP_PORT=80

# The secret sessions are signed with: at least 32 random characters. Make one with: openssl rand -base64 32
# When moving from another machine, copy that machine's value, so what it signed stays valid.
LINKSINK_AUTH_SECRET=

# How mail is sent (the link that confirms the email address, a password reset). Empty means resend: the Resend API
# key, and a From address on a domain verified in Resend, e.g. LinkSink <mail@links.example.com>.
LINKSINK_MAIL_TRANSPORT=
LINKSINK_RESEND_API_KEY=
LINKSINK_MAIL_FROM=

# The image to run. Empty: ghcr.io/laststep/linksink:latest. deploy/update.sh writes this line when it is given an
# image; set it by hand to stay on one version (ghcr.io/laststep/linksink:1.2.0) or one digest (...@sha256:...).
LINKSINK_IMAGE=
