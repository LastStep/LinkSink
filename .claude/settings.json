  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || exit 0; \"$b\" hook record",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor|Agent|Task|SendMessage|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || { echo \"bonsai guard: no bonsai is installed at C:/Program Files/Bonsai/bonsai.exe or /usr/local/bin/bonsai, so this call is refused; next: tell the person: a person installs Bonsai there\" >&2; exit 2; }; \"$b\" hook guard || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(?!Edit$)(?!Write$)(?!MultiEdit$)(?!NotebookEdit$)(?!Bash$)(?!PowerShell$)(?!Monitor$)(?!Agent$)(?!Task$)(?!SendMessage$)(?!Workflow$).*",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || exit 0; \"$b\" hook guard --second",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || { echo \"bonsai stop: no bonsai is installed at C:/Program Files/Bonsai/bonsai.exe or /usr/local/bin/bonsai, so the stop gate cannot check this session, which may not end yet (Claude Code ends the turn after its cap of blocks); next: tell the person: a person installs Bonsai there\" >&2; exit 2; }; \"$b\" hook stop || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || exit 0; \"$b\" hook record",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"/c/Program Files/Bonsai/bonsai.exe\"; [ -x \"$b\" ] || b=/usr/local/bin/bonsai; [ -x \"$b\" ] || exit 0; \"$b\" hook start",
